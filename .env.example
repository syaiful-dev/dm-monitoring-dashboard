# Server
PORT=3000
NODE_ENV=development

# ============================================================
# DATA SOURCE — this is the switch you control
#   TREND_SOURCE=csv  → read CSV files from data/Trenddata/  (current / default)
#   TREND_SOURCE=db   → connect to the database table directly
# Change this one value to switch. No code changes needed.
# ============================================================
TREND_SOURCE=csv

# --- Database settings (only used when TREND_SOURCE=db) ---
# Up to 5 databases (same schema) are combined into one view. Fill each connection
# you use (TREND_DB1_* .. TREND_DB5_*); leave unused ones blank.
# Each connection can be MSSQL or MySQL — set TREND_DBx_CLIENT:
#   TREND_DBx_CLIENT=mssql   (default; SQL Server — query uses TOP + dbo.TABLE, port 1433)
#   TREND_DBx_CLIENT=mysql   (MySQL/MariaDB — query uses LIMIT + TABLE, port 3306)
# Wrap passwords in "double quotes" if they contain # or spaces.
TREND_DB_CLIENT=mssql
# Fully-qualified table holding the document rows (database.schema.table for MSSQL;
# the "dbo." part is stripped automatically for MySQL connections).
TREND_DB_TABLE=integration_ehub.dbo.DOCUMENT
TREND_DB_TIMEOUT_MS=30000

# --- Connection 1 (MSSQL example) ---
TREND_DB1_NAME=DB 1
TREND_DB1_CLIENT=mssql
TREND_DB1_HOST=your-db-host          # e.g. 10.0.0.5  or  DBSERVER\INSTANCE
TREND_DB1_PORT=1433
TREND_DB1_DATABASE=your_database
TREND_DB1_USER=your_readonly_user
TREND_DB1_PASSWORD=your_password
TREND_DB1_ENCRYPT=false              # true for Azure SQL / TLS-required servers
TREND_DB1_TRUST_CERT=true

# --- Connection 2 (MySQL example) ---
TREND_DB2_NAME=DB 2
TREND_DB2_CLIENT=mysql
TREND_DB2_HOST=
TREND_DB2_PORT=3306
TREND_DB2_DATABASE=
TREND_DB2_USER=
TREND_DB2_PASSWORD=
TREND_DB2_ENCRYPT=false              # true to connect over TLS
TREND_DB2_TRUST_CERT=true            # false = verify server cert (encrypt must be true)

# --- Connection 3 ---
TREND_DB3_NAME=DB 3
TREND_DB3_CLIENT=mssql
TREND_DB3_HOST=
TREND_DB3_PORT=1433
TREND_DB3_DATABASE=
TREND_DB3_USER=
TREND_DB3_PASSWORD=
TREND_DB3_ENCRYPT=false
TREND_DB3_TRUST_CERT=true

# --- Connection 4 ---
TREND_DB4_NAME=DB 4
TREND_DB4_CLIENT=mssql
TREND_DB4_HOST=
TREND_DB4_PORT=1433
TREND_DB4_DATABASE=
TREND_DB4_USER=
TREND_DB4_PASSWORD=
TREND_DB4_ENCRYPT=false
TREND_DB4_TRUST_CERT=true

# --- Connection 5 ---
TREND_DB5_NAME=DB 5
TREND_DB5_CLIENT=mssql
TREND_DB5_HOST=
TREND_DB5_PORT=1433
TREND_DB5_DATABASE=
TREND_DB5_USER=
TREND_DB5_PASSWORD=
TREND_DB5_ENCRYPT=false
TREND_DB5_TRUST_CERT=true

# Missing-file alert re-alert window (minutes)
ALERT_REVIEW_MINUTES=30

# ============================================================
# CHATBOT LLM (optional) — local Ollama for natural-language answers
# When enabled, questions the rule-based bot can't answer are sent to a
# local Ollama model, grounded in a live data snapshot. If Ollama is not
# running, the chatbot safely falls back to its built-in responses.
# ============================================================
LLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_MS=20000

# ============================================================
# ADMIN LOGIN (configuration page at /admin)
# ============================================================
ADMIN_USERNAME=admin
# Preferred: a bcrypt hash. Generate with:  node scripts/hash-password.js "yourPassword"
ADMIN_PASSWORD_HASH=
# Fallback plaintext (demo only — use the hash in real use). Default if unset: admin123
ADMIN_PASSWORD=admin123
# Secret used to sign the session cookie — change to any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# ============================================================
# AMAZON QUICK AI ASSISTANT (embed)
# The deployed Quick agent embed/portal URL. Leave blank until the AWS
# embedding stack is deployed and you have the URL.
# ============================================================
QUICK_EMBED_URL=

# PRODUCTION HARDENING
# NODE_ENV=production requires SESSION_SECRET (app exits without it), trusts the nginx
# proxy and sets secure session cookies over HTTPS.
# Cross-origin (CORS / Socket.io) is blocked in production unless listed here (comma-separated).
# Leave blank when the UI is served from the same host.
ALLOWED_ORIGIN=
